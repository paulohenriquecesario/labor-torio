NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: chave da YouTube Data API v3. Sem ela, o coletor de YouTube
# cai para scraping best-effort da página de busca (menos confiável).
YOUTUBE_API_KEY=

# Opcional: endpoint de speech-to-text (ex: Whisper) para transcrever
# material enviado manualmente sem legenda (áudio/vídeo fora do YouTube).
TRANSCRICAO_API_URL=
TRANSCRICAO_API_KEY=

# Segredo para autenticar chamadas do cron externo em /api/jobs/diario
CRON_SECRET=
